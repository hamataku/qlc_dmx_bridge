#!/usr/bin/env python3
"""dmx2artnet - FTDI (Open DMX 系) で受けた DMX512 を Art-Net に変換して QLC+ へ渡すブリッジ

- /dev/serial/by-id/<デバイス> を 250000 baud 8N2 で開き、BREAK 同期でフレームを復元する
- 50 Hz の内部タイマーで変換を適用し、ArtDMX パケットとして送る (既定: 127.0.0.1:6454, universe 0)
- デバイスが無い / 抜かれた場合は 1 秒おきに再接続を待つ (常駐前提)

変換 (すべて卓の「生の値」で判定し、この順に適用):
  --logic    OUT=式        条件が真なら OUT に 255、偽なら 0        例 107=ch5>10
  --gate     CH:TH:OUT     CH が TH 以下なら OUT=0、超えたら 255     例 6:10:106
  --deadzone CH:TH         TH 以下→0、TH+1..255→1..255 に引き伸ばし   例 6:10
  --map      CH:lo-hi=v/.. 範囲ごとに固定値 v または a-b で線形補間   例 5:0-10=0/11-88=0/89-166=10
  --random   CH:TH:T1-T2:O1/O2/O3   CH が TH 超のとき O1..O3 (RGB) にランダム色。切替周期は TH+1→T1 ms, 255→T2 ms
  --strobe   CH:TH:T1-T2:O1/O2/..   CH が TH 超のとき O1.. を周期的に 0 にする。半周期は TH+1→T1 ms, 255→T2 ms
  --colormod CH:TH:T1-T2:O1/O2/O3   CH が TH 超のとき O1..O3 (RGB) の色を HSV で揺らす。明度は固定、
                                   色相の振れ幅 (最大 ±180°) と彩度の注入量と速度が CH に比例。周期は TH+1→T1 ms, 255→T2 ms
  --randomset CH:TH:T1-T2:OUT=spec;OUT=spec;...
                                   CH が TH 超のとき、周期 (TH+1→T1 ms, 255→T2 ms) ごとに各 OUT の値を spec から引き直す。
                                   spec は / 区切りの候補からランダムに 1 つ選ぶ。候補: 固定値 v、範囲 a-b (一様乱数)、
                                   a-b* (乱数ではなく CH の量に比例: TH+1→a, 255→b)。CH が TH 以下なら全 OUT を 0 にする
"""
import os, sys, time, struct, fcntl, termios, select, socket, signal, argparse, errno, random, math, colorsys

DEFAULT_DEV = "/dev/serial/by-id/usb-FTDI_FT232R_USB_UART_BG01OIGN-if00-port0"
TCGETS2, TCSETS2, BOTHER, CBAUD = 0x802C542A, 0x402C542B, 0o10000, 0o10017
TERMIOS2 = "IIIIB19sII"
TICK = 0.02  # 50 Hz
PALETTE = [(255, 0, 0), (0, 255, 0), (0, 0, 255), (255, 255, 0), (0, 255, 255), (255, 0, 255), (255, 255, 255), (255, 80, 0)]

ap = argparse.ArgumentParser()
ap.add_argument("--dev", default=DEFAULT_DEV)
ap.add_argument("--host", default="127.0.0.1")
ap.add_argument("--port", type=int, default=6454)
ap.add_argument("--universe", type=int, default=0, help="Art-Net universe (15bit: net/subnet/universe)")
ap.add_argument("--keepalive", type=float, default=1.0, help="変化が無くても送る間隔 [秒]")
ap.add_argument("--deadzone", default="")
ap.add_argument("--gate", default="")
ap.add_argument("--map", default="")
ap.add_argument("--logic", default="")
ap.add_argument("--random", default="")
ap.add_argument("--strobe", default="")
ap.add_argument("--colormod", default="")
ap.add_argument("--randomset", default="")
ap.add_argument("-v", "--verbose", action="store_true")
args = ap.parse_args()

def split_items(spec):
    return [x.strip() for x in spec.split(",") if x.strip()]

def lin(v, th, t1, t2):
    """v (th+1..255) を t1..t2 に線形補間"""
    return t1 + (t2 - t1) * (v - th - 1) / max(1, 254 - th)

DEAD = {}
for item in split_items(args.deadzone):
    ch, th = item.split(":"); DEAD[int(ch) - 1] = int(th)
GATE = {}
for item in split_items(args.gate):
    ch, th, out = item.split(":"); GATE[int(ch) - 1] = (int(th), int(out) - 1)
MAP = {}
for item in split_items(args.map):
    ch, spec = item.split(":", 1); table = list(range(256))
    for part in spec.split("/"):
        rng, val = part.split("="); lo, hi = int(rng.split("-")[0]), int(rng.split("-")[1])
        if "-" in val:
            a, b = int(val.split("-")[0]), int(val.split("-")[1])
            for v in range(lo, hi + 1): table[v] = round(a + (b - a) * (v - lo) / max(1, hi - lo))
        else:
            for v in range(lo, hi + 1): table[v] = int(val)
    MAP[int(ch) - 1] = table
LOGIC = []
for item in split_items(args.logic):
    out, expr = item.split("=", 1)
    expr = expr.replace("&", " and ").replace("|", " or ").replace("!", " not ")
    LOGIC.append((int(out) - 1, compile(expr, "<logic>", "eval")))
RANDOM = []   # [ch, th, t1, t2, [outs], state]
for item in split_items(args.random):
    ch, th, rng, outs = item.split(":"); t1, t2 = rng.split("-")
    RANDOM.append([int(ch) - 1, int(th), float(t1), float(t2), [int(o) - 1 for o in outs.split("/")], {"next": 0.0, "color": PALETTE[0]}])
STROBE = []   # [ch, th, t1, t2, [outs]]
for item in split_items(args.strobe):
    ch, th, rng, outs = item.split(":"); t1, t2 = rng.split("-")
    STROBE.append([int(ch) - 1, int(th), float(t1), float(t2), [int(o) - 1 for o in outs.split("/")]])

COLORMOD = []   # [ch, th, t1, t2, [outs], state]
for item in split_items(args.colormod):
    ch, th, rng, outs = item.split(":"); t1, t2 = rng.split("-")
    COLORMOD.append([int(ch) - 1, int(th), float(t1), float(t2), [int(o) - 1 for o in outs.split("/")],
                     {"t": None, "p1": 0.0, "p2": 0.0, "p3": 0.0, "hbase": 0.0}])

RANDOMSET = []  # [ch, th, t1, t2, [(out, [choice,...])], state]
for item in split_items(args.randomset):
    ch, th, rng, spec = item.split(":", 3); t1, t2 = rng.split("-")
    outs = []
    for part in [x for x in spec.split(";") if x.strip()]:
        out, cands = part.split("=")
        choices = []
        for c in cands.split("/"):
            if c.endswith("*"):
                a, b = c[:-1].split("-"); choices.append(("scaled", int(a), int(b)))
            elif "-" in c:
                a, b = c.split("-"); choices.append(("uniform", int(a), int(b)))
            else:
                choices.append(("fixed", int(c), int(c)))
        outs.append((int(out) - 1, choices))
    RANDOMSET.append([int(ch) - 1, int(th), float(t1), float(t2), outs, {"next": 0.0, "picks": {}}])

def colormod(rgb, a, st, now, period_s):
    """rgb: 0-255 の基準色, a: 0..1 の効果量, period_s: 揺れの基本周期 [秒]"""
    dt = 0.0 if st["t"] is None else max(0.0, min(0.2, now - st["t"]))
    st["t"] = now
    w = 2 * math.pi / max(0.05, period_s)
    st["p1"] += w * dt; st["p2"] += w * 1.618 * dt; st["p3"] += w * 0.5 * dt
    st["hbase"] = (st["hbase"] + 0.02 * dt) % 1.0          # 白/灰のとき使う基準色相 (50 秒で一周)
    r, g, b = (c / 255.0 for c in rgb)
    h, sat, v = colorsys.rgb_to_hsv(r, g, b)
    if v <= 0.0:
        return rgb
    if sat < 0.1:                                             # ほぼ白: 色相が無いので回転する基準色相に乗せる
        h = st["hbase"]
    drift = 0.7 * math.sin(st["p1"]) + 0.3 * math.sin(st["p2"] + 1.0)   # -1..1 の準周期的な揺れ
    h2 = (h + 0.5 * a * drift) % 1.0                                     # 最大 ±180 度
    inject = a * (0.5 + 0.5 * math.sin(st["p3"]))                        # 彩度の注入 (白をパステル→鮮やかへ)
    s2 = min(1.0, sat + (1.0 - sat) * inject)
    r2, g2, b2 = colorsys.hsv_to_rgb(h2, s2, v)
    return (round(r2 * 255), round(g2 * 255), round(b2 * 255))

def transform(raw, now):
    b = bytearray(raw)
    if LOGIC:
        env = {f"ch{i + 1}": raw[i] for i in range(len(raw))}
        for out, code in LOGIC:
            if out < len(b): b[out] = 255 if eval(code, {"__builtins__": {}}, env) else 0
    for idx, (th, out) in GATE.items():
        if idx < len(b) and out < len(b): b[out] = 0 if raw[idx] <= th else 255
    for idx, th in DEAD.items():
        if idx < len(b):
            v = raw[idx]; b[idx] = 0 if v <= th else max(1, round((v - th) * 255 / (255 - th)))
    for idx, table in MAP.items():
        if idx < len(b): b[idx] = table[raw[idx]]
    for ch, th, t1, t2, outs, st in RANDOM:
        if raw[ch] > th:
            if now >= st["next"]:
                st["color"] = random.choice([c for c in PALETTE if c != st["color"]])
                st["next"] = now + lin(raw[ch], th, t1, t2) / 1000.0
            for o, v in zip(outs, st["color"]): b[o] = v
        else:
            st["next"] = 0.0
    for ch, th, t1, t2, outs, st in COLORMOD:
        if raw[ch] > th:
            a = (raw[ch] - th) / (255 - th)
            base = tuple(b[o] for o in outs)
            for o, v in zip(outs, colormod(base, a, st, now, lin(raw[ch], th, t1, t2) / 1000.0)): b[o] = v
        else:
            st["t"] = None
    for ch, th, t1, t2, outs, st in RANDOMSET:
        if raw[ch] > th:
            a = (raw[ch] - th) / (255 - th)
            if now >= st["next"]:
                st["next"] = now + lin(raw[ch], th, t1, t2) / 1000.0
                for out, choices in outs:
                    kind, lo, hi = random.choice(choices)
                    st["picks"][out] = (kind, lo, hi, random.randint(lo, hi) if kind == "uniform" else lo)
            for out, _ in outs:
                kind, lo, hi, val = st["picks"][out]
                b[out] = round(lo + (hi - lo) * a) if kind == "scaled" else val
        else:
            st["next"] = 0.0
            for out, _ in outs: b[out] = 0
    for ch, th, t1, t2, outs in STROBE:
        if raw[ch] > th:
            half = lin(raw[ch], th, t1, t2) / 1000.0
            if int(now / half) % 2 == 1:
                for o in outs: b[o] = 0
    return bytes(b)

running = True
def _stop(*_):
    global running
    running = False
signal.signal(signal.SIGTERM, _stop)
signal.signal(signal.SIGINT, _stop)

def log(*a):
    print(time.strftime("%H:%M:%S"), *a, flush=True)

def open_dmx(path):
    fd = os.open(path, os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
    try:
        buf = bytearray(struct.calcsize(TERMIOS2))
        fcntl.ioctl(fd, TCGETS2, buf)
        _, _, cflag, _, line, cc, _, _ = struct.unpack(TERMIOS2, buf)
        cflag &= ~(termios.CSIZE | termios.PARENB | CBAUD | termios.CRTSCTS)
        cflag |= termios.CS8 | termios.CSTOPB | termios.CREAD | termios.CLOCAL | BOTHER
        cc = bytearray(cc); cc[termios.VMIN] = 0; cc[termios.VTIME] = 0
        # PARMRK: BREAK -> ff 00 00, framing error -> ff 00 xx, literal 0xff -> ff ff
        fcntl.ioctl(fd, TCSETS2, struct.pack(TERMIOS2, termios.PARMRK, 0, cflag, 0, line, bytes(cc), 250000, 250000))
        termios.tcflush(fd, termios.TCIOFLUSH)
    except Exception:
        os.close(fd)
        raise
    return fd

sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
seq = 0
def send_artnet(channels):
    global seq
    seq = seq % 255 + 1
    data = bytes(channels[:512]).ljust(512, b"\x00")
    pkt = b"Art-Net\x00" + struct.pack("<H", 0x5000) + struct.pack(">H", 14) \
        + bytes([seq, 0, args.universe & 0xFF, (args.universe >> 8) & 0x7F]) + struct.pack(">H", len(data)) + data
    sock.sendto(pkt, (args.host, args.port))

log(f"dmx2artnet start: dev={args.dev} -> {args.host}:{args.port} universe={args.universe} "
    f"deadzone={ {k+1: v for k, v in DEAD.items()} } gate={ {k+1: (t, o+1) for k, (t, o) in GATE.items()} } "
    f"map={[k+1 for k in MAP]} logic={[o+1 for o, _ in LOGIC]} random={[r[0]+1 for r in RANDOM]} strobe={[s[0]+1 for s in STROBE]} colormod={[c[0]+1 for c in COLORMOD]} randomset={[r[0]+1 for r in RANDOMSET]}")
raw = bytes(512)
last_sent = None; last_sent_t = 0.0
while running:
    if not os.path.exists(args.dev):
        time.sleep(1.0)
        continue
    try:
        fd = open_dmx(args.dev)
    except OSError as e:
        log(f"open failed ({e}); retrying"); time.sleep(1.0); continue
    log("device opened, waiting for DMX")
    state = 0; cur = None; frames = 0; last_report = time.time(); receiving = False; lens = []
    last_frame_t = 0.0; next_tick = time.monotonic()
    try:
        while running:
            timeout = max(0.0, next_tick - time.monotonic())
            r, _, _ = select.select([fd], [], [], timeout)
            if r:
                data = os.read(fd, 4096)
                if not data:
                    raise OSError(errno.EIO, "EOF from device")
                for byte in data:
                    if state == 0:
                        if byte == 0xFF: state = 1
                        elif cur is not None: cur.append(byte)
                    elif state == 1:
                        if byte == 0xFF:
                            if cur is not None: cur.append(0xFF)
                            state = 0
                        elif byte == 0x00: state = 2
                        else:
                            if cur is not None: cur.append(byte)
                            state = 0
                    else:  # state 2: ff 00 xx
                        if byte == 0x00:  # BREAK -> frame boundary
                            if cur is not None and len(cur) >= 2 and cur[0] == 0x00:
                                frames += 1
                                lens.append(len(cur)); del lens[:-50]
                                expected = max(set(lens), key=lens.count) if len(lens) >= 10 else len(cur)
                                if len(cur) == expected:
                                    raw = bytes(cur[1:513]).ljust(512, b"\x00")
                                    last_frame_t = time.time()
                                    if not receiving:
                                        receiving = True; log(f"receiving DMX: {len(cur) - 1} channels/frame")
                            cur = bytearray()
                        state = 0
            mono = time.monotonic()
            if mono >= next_tick:
                next_tick += TICK
                if mono - next_tick > 1.0: next_tick = mono + TICK
                now = time.time()
                out = transform(raw, mono)
                if out != last_sent or now - last_sent_t >= args.keepalive:
                    send_artnet(out); last_sent = out; last_sent_t = now
                if receiving and now - last_frame_t > 2.0:
                    receiving = False; log("DMX signal lost (no frames for 2s)")
                if args.verbose and now - last_report >= 5.0:
                    nz = [(i + 1, v) for i, v in enumerate(out) if v][:12]
                    log(f"frames={frames} out nonzero={nz}"); last_report = now
    except OSError as e:
        log(f"device error ({e}); will reconnect")
    finally:
        try: os.close(fd)
        except OSError: pass
    time.sleep(1.0)
log("dmx2artnet stopped")
